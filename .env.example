# DIBOT_AGENT_DATA_API
DIBOT_API_URL=https://mastra.example.com
DIBOT_AGENT_API_TOKEN=replace-with-a-server-only-token

# Turso Platform + app database defaults
TURSO_PLATFORM_API_TOKEN=replace-with-a-turso-platform-token
TURSO_ORG_SLUG=apps-factory
TURSO_GROUP=dibot
TURSO_DATABASE_NAME=dibot-template

# GitHub
GITHUB_TOKEN=replace-with-a-github-token
GITHUB_OWNER=Apps-Factory-Colombia
DIBOT_TEMPLATE_REPOSITORY=Apps-Factory-Colombia/prueba-dibot

# Dokploy
DOKPLOY_API_URL=https://dokploy.example.com/api
DOKPLOY_API_KEY=replace-with-a-dokploy-api-key
DOKPLOY_PROJECT_NAME=Apps-Dibot
DOKPLOY_ENVIRONMENT_ID=optional-environment-id
DOKPLOY_SERVER_ID=optional-server-id
DOKPLOY_DOMAIN_SUFFIX=dibot.example.com
